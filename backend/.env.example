NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: MongoDB URI (Atlas or local). If blank or fails to connect in development, an in-memory Mongo engine will start automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/weldmonitor

# JWT Secret for access token signature
JWT_SECRET=weldmonitor_super_secret_jwt_development_key_2026_xyz987

# Google Cloud OAuth credentials (optional for development mock/OAuth)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Brevo Email Service (optional; logs to server console in dev if not configured)
BREVO_API_KEY=xkeysib-mock-api-key-for-dev
EMAIL_FROM=weldmonitor@industrial.io
EMAIL_FROM_NAME=WeldMonitor Alert System
